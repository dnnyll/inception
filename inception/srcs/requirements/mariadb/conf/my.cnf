# Custom MariaDB server configuration.
# This overrides the default 50-server.cnf shipped with the package.

[mysqld]

# Run the MySQL/MariaDB process as the "mysql" system user,
# never as root - standard security practice
user = mysql

# By default MariaDB only listens on localhost (127.0.0.1),
# which would block connections from OTHER containers
# (like WordPress). 0.0.0.0 means "listen on all network
# interfaces", so the docker network can reach it.
bind-address = 0.0.0.0

# Where the actual database files live on disk inside the container
# (this path will later be backed by our named volume, so data
# survives container restarts)
datadir = /var/lib/mysql
